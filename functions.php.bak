        <?php
    }
}

// Sanitize service cards repeater
function futuristic_it_sanitize_service_cards($input) {
    $sanitized = array();
    if (is_array($input)) {
        foreach ($input as $card) {
            $sanitized[] = array(
                'icon'      => isset($card['icon']) ? sanitize_text_field($card['icon']) : '',
                'title'     => isset($card['title']) ? sanitize_text_field($card['title']) : '',
                'desc'      => isset($card['desc']) ? sanitize_textarea_field($card['desc']) : '',
                'link'      => isset($card['link']) ? esc_url_raw($card['link']) : '',
                'link_text' => isset($card['link_text']) ? sanitize_text_field($card['link_text']) : 'Learn More',
            );
        }
    }
    return $sanitized;
}

// Customizer Repeater Control Class
if (class_exists('WP_Customize_Control')) {
    class futuristic_it_repeater_control extends WP_Customize_Control {
        public $type = 'futuristic-it-repeater';

        public function render_content() {
            $value = $this->value();
            if (!is_array($value)) {
                $value = array();
            }
            ?>
            <div class="futuristic-it-repeater-wrap" data-field="<?php echo esc_attr($this->id); ?>">
                <div class="repeater-items">
                    <?php foreach ($value as $index => $item) : ?>
                        <div class="repeater-item" data-index="<?php echo esc_attr($index); ?>">
                            <div class="repeater-item-header">
                                <span class="repeater-item-title"><?php echo esc_html(isset($item['title']) ? $item['title'] : 'Service ' . ($index + 1)); ?></span>
                                <button type="button" class="repeater-remove" title="Remove">&times;</button>
                            </div>
                            <div class="repeater-item-body">
                                <p>
                                    <label>Icon (emoji)</label>
                                    <input type="text" class="widefat" value="<?php echo esc_attr(isset($item['icon']) ? $item['icon'] : ''); ?>" data-field="icon" placeholder="e.g., 💻">
                                </p>
                                <p>
                                    <label>Title</label>
                                    <input type="text" class="widefat" value="<?php echo esc_attr(isset($item['title']) ? $item['title'] : ''); ?>" data-field="title" placeholder="Service Title">
                                </p>
                                <p>
                                    <label>Description</label>
                                    <textarea class="widefat" rows="3" data-field="desc" placeholder="Short description..."><?php echo esc_textarea(isset($item['desc']) ? $item['desc'] : ''); ?></textarea>
                                </p>
                                <p>
                                    <label>Link URL</label>
                                    <input type="url" class="widefat" value="<?php echo esc_attr(isset($item['link']) ? $item['link'] : ''); ?>" data-field="link" placeholder="/services/...">
                                </p>
                                <p>
                                    <label>Link Text</label>
                                    <input type="text" class="widefat" value="<?php echo esc_attr(isset($item['link_text']) ? $item['link_text'] : 'Learn More'); ?>" data-field="link_text" placeholder="Learn More">
                                </p>
                            </div>
                        </div>
                    <?php endforeach; ?>
                </div>
                <button type="button" class="button button-secondary repeater-add">+ Add Service Card</button>
                <input type="hidden" <?php echo esc_attr($this->input_attrs); ?> value="<?php echo esc_attr(wp_json_encode($value)); ?>" <?php echo esc_attr($this->get_link()); ?> />
            </div>
            <?php
        }
    }
}
add_action('after_setup_theme', 'futuristic_it_theme_setup');

// Load templates from subfolders
function futuristic_it_custom_templates($template) {
    if (is_front_page()) {
        $custom = get_template_directory() . '/home/front-page.php';
        if (file_exists($custom)) return $custom;
    }
    if (is_page_template('page-about.php')) {
        $custom = get_template_directory() . '/about/page-about.php';
        if (file_exists($custom)) return $custom;
    }
    if (is_page_template('page-contact.php')) {
        $custom = get_template_directory() . '/contact/page-contact.php';
        if (file_exists($custom)) return $custom;
    }
    if (is_page_template('page-services.php')) {
        $custom = get_template_directory() . '/services/page-services.php';
        if (file_exists($custom)) return $custom;
    }
    if (is_singular('product')) {
        $custom = get_template_directory() . '/product/single-product.php';
        if (file_exists($custom)) return $custom;
    }
    if (is_post_type_archive('product')) {
        $custom = get_template_directory() . '/products/archive-product.php';
        if (file_exists($custom)) return $custom;
    }
    return $template;
}
add_filter('template_include', 'futuristic_it_custom_templates');

// Enqueue Scripts and Styles
function futuristic_it_scripts() {
    wp_enqueue_style('futuristic-it-style', get_template_directory_uri() . '/style.css', array(), '1.0.0');
    
    // Enqueue Google Fonts
    wp_enqueue_style('futuristic-it-fonts', 'https://fonts.googleapis.com/css2?family=Segoe+UI:wght@400;500;600;700&display=swap', array(), null);
    
    // Enqueue main JavaScript (no jQuery dependency)
    wp_enqueue_script('futuristic-it-js', get_template_directory_uri() . '/js/main.js', array(), '1.0.0', true);
}
add_action('wp_enqueue_scripts', 'futuristic_it_scripts');

// Gutenberg Block Editor Support
function futuristic_it_gutenberg_support() {
    add_theme_support('editor-styles');
    add_theme_support('align-wide');
    add_theme_support('wp-block-styles');
    add_theme_support('responsive-embeds');
    add_theme_support('editor-color-palette', array(
        array('name' => 'Dark Green', 'slug' => 'dark-green', 'color' => '#142e1f'),
        array('name' => 'Primary Green', 'slug' => 'primary-green', 'color' => '#1a3d27'),
        array('name' => 'Gold', 'slug' => 'gold', 'color' => '#d4a843'),
        array('name' => 'Gold Dark', 'slug' => 'gold-dark', 'color' => '#b8892f'),
        array('name' => 'Cream', 'slug' => 'cream', 'color' => '#f7f6f1'),
        array('name' => 'White', 'slug' => 'white', 'color' => '#ffffff'),
    ));
    add_theme_support('editor-font-sizes', array(
        array('name' => 'Small', 'slug' => 'small', 'size' => 14),
        array('name' => 'Normal', 'slug' => 'normal', 'size' => 16),
        array('name' => 'Medium', 'slug' => 'medium', 'size' => 20),
        array('name' => 'Large', 'slug' => 'large', 'size' => 28),
        array('name' => 'Huge', 'slug' => 'huge', 'size' => 36),
    ));
}
add_action('after_setup_theme', 'futuristic_it_gutenberg_support');

function futuristic_it_editor_styles() {
    add_editor_style('editor-style.css');
}
add_action('after_setup_theme', 'futuristic_it_editor_styles');

