// Add custom fields for products
function futuristic_it_add_product_meta_boxes() {
    add_meta_box(
        'product_details',
        __('Product Details', 'futuristic-it'),
        'futuristic_it_product_meta_box_callback',
        'product',
        'normal',
        'high'
    );
}
add_action('add_meta_boxes', 'futuristic_it_add_product_meta_boxes');

function futuristic_it_product_meta_box_callback($post) {
    wp_nonce_field('futuristic_it_product_meta_box', 'futuristic_it_product_meta_box_nonce');
    
    $price = get_post_meta($post->ID, '_product_price', true);
    $features = get_post_meta($post->ID, '_product_features', true);
    
    echo '<label for="product_price">' . __('Price:', 'futuristic-it') . '</label>';
    echo '<input type="text" id="product_price" name="product_price" value="' . esc_attr($price) . '" class="widefat" style="margin-bottom: 15px;">';
    
    echo '<label for="product_features">' . __('Features (one per line):', 'futuristic-it') . '</label>';
    echo '<textarea id="product_features" name="product_features" class="widefat" rows="5">' . esc_textarea($features) . '</textarea>';
}

function futuristic_it_save_product_meta($post_id) {
    if (!isset($_POST['futuristic_it_product_meta_box_nonce'])) {
        return;
    }
    
    if (!wp_verify_nonce($_POST['futuristic_it_product_meta_box_nonce'], 'futuristic_it_product_meta_box')) {
        return;
    }
    
    if (defined('DOING_AUTOSAVE') && DOING_AUTOSAVE) {
        return;
    }
    
    if (!current_user_can('edit_post', $post_id)) {
        return;
    }
    
    if (isset($_POST['product_price'])) {
        update_post_meta($post_id, '_product_price', sanitize_text_field($_POST['product_price']));
    }
    
    if (isset($_POST['product_features'])) {
        update_post_meta($post_id, '_product_features', sanitize_textarea_field($_POST['product_features']));
    }
}
add_action('save_post', 'futuristic_it_save_product_meta');

