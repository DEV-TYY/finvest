        59
    );
}
add_action('admin_menu', 'futuristic_it_add_theme_options_page');

function futuristic_it_register_theme_options() {
    foreach (array_keys(futuristic_it_theme_option_fields()) as $field) {
        register_setting('futuristic_it_theme_options_group', $field, 'sanitize_text_field');
    }
    // Register dynamic FAQ options
    for ($i = 1; $i <= 5; $i++) {
        register_setting('futuristic_it_theme_options_group', 'contact_faq_' . $i . '_q', 'sanitize_text_field');
        register_setting('futuristic_it_theme_options_group', 'contact_faq_' . $i . '_a', 'sanitize_textarea_field');
    }
    // Register about FAQ options
    for ($i = 1; $i <= 5; $i++) {
        register_setting('futuristic_it_theme_options_group', 'about_faq_' . $i . '_q', 'sanitize_text_field');
        register_setting('futuristic_it_theme_options_group', 'about_faq_' . $i . '_a', 'sanitize_textarea_field');
    }
    // Register about timeline options
    for ($i = 1; $i <= 6; $i++) {
        register_setting('futuristic_it_theme_options_group', 'about_timeline_' . $i . '_year', 'sanitize_text_field');
        register_setting('futuristic_it_theme_options_group', 'about_timeline_' . $i . '_text', 'sanitize_textarea_field');
    }
    // Register services reliability points
    for ($i = 1; $i <= 6; $i++) {
        register_setting('futuristic_it_theme_options_group', 'services_reliability_' . $i . '_title', 'sanitize_text_field');
        register_setting('futuristic_it_theme_options_group', 'services_reliability_' . $i . '_text', 'sanitize_textarea_field');
    }
}
add_action('admin_init', 'futuristic_it_register_theme_options');

