// Customizer Live Preview Script
function futuristic_it_customize_preview_js() {
    wp_enqueue_script('futuristic-it-customizer', get_template_directory_uri() . '/js/customizer.js', array('customize-preview'), '1.0.0', true);
}
add_action('customize_preview_init', 'futuristic_it_customize_preview_js);

// Enqueue Customizer controls script on admin
function futuristic_it_customize_admin_scripts() {
    global $pagenow;
    if ('customize.php' === $pagenow) {
        wp_enqueue_script('futuristic-it-customizer-controls', get_template_directory_uri() . '/js/customizer-controls.js', array('jquery'), '1.0.0', true);
        wp_enqueue_script('futuristic-it-customizer-repeater', get_template_directory_uri() . '/js/customizer-repeater.js', array('jquery'), '1.0.0', true);
        wp_add_inline_style('admin-customizer', '
            .futuristic-it-repeater-wrap { margin-top: 10px; }
            .repeater-item { background: #fff; border: 1px solid #ddd; margin-bottom: 8px; border-radius: 4px; }
            .repeater-item-header { padding: 10px 12px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; background: #f9f9f9; border-bottom: 1px solid #eee; }
            .repeater-item-header:hover { background: #f0f0f0; }
            .repeater-item-title { font-weight: 600; font-size: 13px; }
            .repeater-remove { background: none; border: none; color: #a00; font-size: 18px; cursor: pointer; padding: 0 4px; line-height: 1; }
            .repeater-remove:hover { color: #dc3232; }
            .repeater-item-body { padding: 12px; display: none; }
            .repeater-item.expanded .repeater-item-body { display: block; }
            .repeater-item-body p { margin: 8px 0; }
            .repeater-item-body label { display: block; font-weight: 600; margin-bottom: 4px; font-size: 12px; color: #555; }
            .repeater-item-body .widefat { width: 100%; }
        ');
    }
}
add_action('admin_enqueue_scripts', 'futuristic_it_customize_admin_scripts');

// Register Custom Post Type: Services
function futuristic_it_register_services() {
    $labels = array(
        'name' => __('Services', 'futuristic-it'),
        'singular_name' => __('Service', 'futuristic-it'),
        'menu_name' => __('Services', 'futuristic-it'),
        'add_new' => __('Add New', 'futuristic-it'),
        'add_new_item' => __('Add New Service', 'futuristic-it'),
        'edit_item' => __('Edit Service', 'futuristic-it'),
        'new_item' => __('New Service', 'futuristic-it'),
        'view_item' => __('View Service', 'futuristic-it'),
        'search_items' => __('Search Services', 'futuristic-it'),
        'not_found' => __('No services found', 'futuristic-it'),
        'not_found_in_trash' => __('No services found in Trash', 'futuristic-it'),
    );

    $args = array(
        'labels' => $labels,
        'public' => true,
        'has_archive' => true,
        'publicly_queryable' => true,
        'query_var' => true,
        'rewrite' => array('slug' => 'services'),
        'capability_type' => 'post',
        'hierarchical' => false,
        'menu_position' => 3,
        'menu_icon' => 'dashicons-admin-generic',
        'supports' => array('title', 'editor', 'thumbnail', 'excerpt'),
        'show_in_rest' => true,
    );

    register_post_type('service', $args);
}
