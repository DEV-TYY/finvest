        <form method="post" action="options.php">
            <?php settings_fields('futuristic_it_theme_options_group'); ?>
            <?php foreach ($sections as $section_title => $field_keys) : ?>
                <h2 style="margin-top: 24px; padding-bottom: 8px; border-bottom: 1px solid #ccd0d4;"><?php echo esc_html($section_title); ?></h2>
                <table class="form-table">
                    <?php foreach ($field_keys as $field) :
                        $default = isset($fields[$field]) ? $fields[$field] : '';
                        $value = get_option($field, $default);
                        $is_textarea = strpos($field, 'subtitle') !== false || strpos($field, 'lead') !== false || strpos($field, '_text') !== false || strpos($field, 'tagline') !== false || strpos($field, 'mission') !== false || strpos($field, 'vision') !== false;
                    ?>
                        <tr>
                            <th scope="row">
                                <label for="<?php echo esc_attr($field); ?>">
                                    <?php echo esc_html(ucwords(str_replace(array('purposity_', 'futuristic_'), '', str_replace('_', ' ', $field)))); ?>
                                </label>
                            </th>
                            <td>
                                <?php if ($is_textarea) : ?>
                                    <textarea class="large-text" id="<?php echo esc_attr($field); ?>" name="<?php echo esc_attr($field); ?>" rows="3"><?php echo esc_textarea($value); ?></textarea>
                                <?php else : ?>
                                    <input type="text" class="regular-text" id="<?php echo esc_attr($field); ?>" name="<?php echo esc_attr($field); ?>" value="<?php echo esc_attr($value); ?>">
                                <?php endif; ?>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                </table>
            <?php endforeach; ?>
            <?php submit_button(); ?>
        </form>
    </div>
    <?php
}