function futuristic_it_service_meta_box_callback($post) {
    wp_nonce_field('futuristic_it_service_meta_box', 'futuristic_it_service_meta_box_nonce');
    
    $icon = get_post_meta($post->ID, '_service_icon', true);
    $link = get_post_meta($post->ID, '_service_link', true);
    $link_text = get_post_meta($post->ID, '_service_link_text', true);
    
    echo '<label for="service_icon">' . __('Icon (emoji or character):', 'futuristic-it') . '</label>';
    echo '<input type="text" id="service_icon" name="service_icon" value="' . esc_attr($icon) . '" class="widefat" placeholder="e.g., 💻, 🔧, 🚀" style="margin-bottom: 15px;">';

    echo '<label for="service_link">' . __('Learn More Link URL (optional, defaults to the service page):', 'futuristic-it') . '</label>';
    echo '<input type="text" id="service_link" name="service_link" value="' . esc_attr($link) . '" class="widefat" placeholder="/services/it-consulting/" style="margin-bottom: 15px;">';

    echo '<label for="service_link_text">' . __('Learn More Link Text:', 'futuristic-it') . '</label>';
    echo '<input type="text" id="service_link_text" name="service_link_text" value="' . esc_attr($link_text) . '" class="widefat" placeholder="Learn More">';
}

function futuristic_it_save_service_meta($post_id) {
    if (!isset($_POST['futuristic_it_service_meta_box_nonce'])) {
        return;
    }
    
    if (!wp_verify_nonce($_POST['futuristic_it_service_meta_box_nonce'], 'futuristic_it_service_meta_box')) {
        return;
    }
    
    if (defined('DOING_AUTOSAVE') && DOING_AUTOSAVE) {
        return;
    }
    
    if (!current_user_can('edit_post', $post_id)) {
        return;
    }
    
    if (isset($_POST['service_icon'])) {
        update_post_meta($post_id, '_service_icon', sanitize_text_field($_POST['service_icon']));
    }
    
    if (isset($_POST['service_link'])) {
        update_post_meta($post_id, '_service_link', sanitize_text_field($_POST['service_link']));
    }
    
    if (isset($_POST['service_link_text'])) {
        update_post_meta($post_id, '_service_link_text', sanitize_text_field($_POST['service_link_text']));
    }
}
add_action('save_post', 'futuristic_it_save_service_meta');

// Add custom fields for CTA features (icon shown next to each bullet
// in the "Built for Dependable Operation" assurance box)
function futuristic_it_add_cta_feature_meta_boxes() {
    add_meta_box(
        'cta_feature_icon',
        __('CTA Feature Icon', 'futuristic-it'),
        'futuristic_it_cta_feature_meta_box_callback',
        'cta_feature',
        'normal',
        'high'
    );
}
add_action('add_meta_boxes', 'futuristic_it_add_cta_feature_meta_boxes');

function futuristic_it_cta_feature_meta_box_callback($post) {
    wp_nonce_field('futuristic_it_cta_feature_meta_box', 'futuristic_it_cta_feature_meta_box_nonce');
    
    $icon = get_post_meta($post->ID, '_cta_icon', true);
    
    echo '<label for="cta_icon">' . __('Icon (emoji or character):', 'futuristic-it') . '</label>';
    echo '<input type="text" id="cta_icon" name="cta_icon" value="' . esc_attr($icon) . '" class="widefat" placeholder="e.g., 🎧, 🎓, 🔄">';
    echo '<p class="description">' . __('The item title uses the Title field above, and the short description uses the main Content editor.', 'futuristic-it') . '</p>';
}

function futuristic_it_save_cta_feature_meta($post_id) {
    if (!isset($_POST['futuristic_it_cta_feature_meta_box_nonce'])) {
        return;
    }
    
    if (!wp_verify_nonce($_POST['futuristic_it_cta_feature_meta_box_nonce'], 'futuristic_it_cta_feature_meta_box')) {
        return;
    }
    
    if (defined('DOING_AUTOSAVE') && DOING_AUTOSAVE) {
        return;
    }
    
    if (!current_user_can('edit_post', $post_id)) {
        return;
    }
    
    if (isset($_POST['cta_icon'])) {
        update_post_meta($post_id, '_cta_icon', sanitize_text_field($_POST['cta_icon']));
    }
}
add_action('save_post', 'futuristic_it_save_cta_feature_meta');

